# Gemini API key + model.
# Optional: you can also set these from the desktop app (⚙ Settings).
# In-app settings are stored in ~/.cursorpilot/settings.json and take precedence
# over these environment variables.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash
DEMO_REPO_PATH=./demo-repo

# Bridge server (Plugin ↔ Engine)
BRIDGE_PORT=8787
BRIDGE_TOKEN=dev-only-token
